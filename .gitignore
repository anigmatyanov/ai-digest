# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
.next/
out/

# env — never commit real secrets
.env
.env.*
!.env.example

# pipeline run artefacts (state of record lives in Postgres, not here)
runs/

# neonctl drops this in the cwd; it holds the org id, not a secret, but it is
# machine-local state and has no business in the repo.
.neon

# local tooling
.DS_Store
*.log
coverage/
.vercel/
.turbo/

# agent worktrees + slot registry (see .claude/rules/backlog.md)
.claude/worktrees/
.claude/settings.local.json

# transformers.js model cache
.cache/

# Pipeline run artefacts are reproducible output, not source. `runs/` was already
# ignored; this keeps the intent visible next to it.

# Prisma client, regenerated from prisma/schema.prisma by the root postinstall hook.
# Committed generated code turns every schema change into a thousand-line diff, and it
# goes stale the moment someone edits the schema without running the generator.
packages/db/src/generated/
