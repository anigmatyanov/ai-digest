# Copy to .env and fill in. Never commit .env — see .gitignore.
# Every variable here must also be declared in packages/core/src/env.ts (zod).

# --- Database (Neon) ---
# Pooled connection (host contains "-pooler") — used by the app and the pipeline.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/aidigest?sslmode=require"
# Direct connection — used by prisma migrate / CLI only.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/aidigest?sslmode=require"

# --- Anthropic ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Telegram ---
TELEGRAM_BOT_TOKEN="123456:ABC..."
TELEGRAM_CHANNEL_ID="@your_channel_or_-100..."
TELEGRAM_OWNER_ID="123456789"
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token; the webhook URL is effectively public.
TELEGRAM_WEBHOOK_SECRET="generate-a-long-random-string"

# --- Site ---
SITE_URL="https://example.vercel.app"
REVALIDATE_SECRET="generate-a-long-random-string"

# --- Sources ---
# Classic PAT: 5000 req/h, versus 1000 req/h for the built-in GITHUB_TOKEN.
GH_PAT="ghp_..."
YOUTUBE_API_KEY=""
